# ===== Required =====
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# ID of your Supplier MasterList sheet (from its URL). POs + Line_Items tabs are added here.
SPREADSHEET_ID=the-long-id-from-your-google-sheet-url
# Paste the FULL service-account JSON on one line (reuse your scheduler bot's service account)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}

# ===== Master list (optional) =====
# Tab that holds your reagents (code, item, supplier, price, pack).
MASTER_TAB=Reagent Master
# Tab that holds non-reagent items, same columns (Name / Unit instead of
# CML Reagent / Pack). The bot only READS both tabs -- it never writes to them.
OTHER_MASTER_TAB=Other Master
# Only set this if the master list is in a DIFFERENT spreadsheet from SPREADSHEET_ID.
MASTER_SPREADSHEET_ID=

# ===== Group chat IDs (run /chatid inside each group to get these) =====
STOCK_CHAT_ID=-1001111111111
BOOKKEEPING_CHAT_ID=-1002222222222
FINANCE_CHAT_ID=-1003333333333
GM_CHAT_ID=-1004444444444
BOARD_CHAT_ID=-1005555555555
# Approved POs land here as two PDFs: the order (forward to the supplier) and
# the approval copy (internal). Delivery discrepancies are reported here too.
# Where fully-approved POs are posted for information (price-free).
APPROVED_PO_CHAT_ID=-1006666666666
# Also posted here when Finance chose the Cash Advance route.
CASH_ADVANCE_CHAT_ID=-1007777777777

# ===== Behaviour (optional) =====
TIMEZONE=Asia/Phnom_Penh
START_PO_NO=172
CURRENCY=$
COMPANY_NAME=CAMMED LAB
# Maximum line items per PO. A larger order becomes several files, one PO each.
MAX_LINES=12
MAX_UPLOAD_MB=2

# ===== Optional approver locks (comma-separated Telegram user IDs; leave blank = anyone in the group) =====
# Run /myid to get a user's ID.
STOCK_APPROVERS=
BOOKKEEPING_APPROVERS=
FINANCE_APPROVERS=
GM_APPROVERS=
BOARD_APPROVERS=

# ===== Supporting documents for management review (optional) =====
# Google Drive folder holding the archive copy of every attachment. It must be
# a folder in a REAL account's Drive, shared (Editor) with the service account
# above: a service account has no storage quota of its own, so a file created
# anywhere else fails. Leave blank to keep attachments in Telegram only.
ATTACHMENTS_FOLDER_ID=1bK7PS0Ir4rBJwro0DygDvBWk1enmqPTl
# PO categories that are asked for supporting documents (lab | other).
ATTACH_CATEGORIES=other
# Stage groups that receive them. stock, approved and cash are refused in code
# whatever is set here -- the stock controller is price-blind and a quotation
# is a price, and the approved-PO group forwards documents to the supplier.
ATTACH_STAGES=book,fin,gm,board
ATTACH_MAX_COUNT=5
ATTACH_MAX_MB=10
